            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="54"
                    android:startY="38"
                    android:endX="54"
                    android:endY="74"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#1A183D" />
                    <item android:offset="1.0" android:color="#0B091B" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Symmetrical Chin / Mouth Guard Plate -->
        <path
            android:fillColor="#24215C"
            android:strokeWidth="0.75"
            android:strokeColor="#8A2BE2"
            android:pathData="M42,58 L66,58 L54,73 Z" />

