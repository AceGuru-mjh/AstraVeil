<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Symmetrical Geometric Cyber Mask (创意面具) -->
    <!-- Centered perfectly within the 108x108 safe zone -->
    <group
        android:translateX="0"
        android:translateY="0">

        <!-- Back Glow / Halo for the mask -->
        <path
            android:pathData="M54,22 L86,40 L86,72 L54,92 L22,72 L22,40 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="54"
                    android:startY="22"
                    android:endX="54"
                    android:endY="92"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#3300FFCC" />
                    <item android:offset="1.0" android:color="#008A2BE2" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Outer Symmetrical Protective Veil Shield (Astra Shield Outer Ring) -->
        <path
            android:strokeWidth="1.5"
            android:strokeColor="#8A2BE2"
            android:strokeLineJoin="round"
            android:pathData="M54,25 L82,41 L82,69 L54,87 L26,69 L26,41 Z" />

        <!-- Outer Shield Accents -->
        <path
            android:strokeWidth="1"
            android:strokeColor="#00FFCC"
            android:pathData="M40,22 L54,14 L68,22" />

        <!-- Standard Forehead Astra Star (Astra极星 / Four-Pointed Star) -->
