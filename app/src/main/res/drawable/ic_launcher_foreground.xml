            android:pathData="M34,44 L74,44 L70,52 L38,52 Z" />

        <!-- Cyber Cheek Highlights (Neon Cyan Diagonal Stripes) -->
        <path
            android:strokeWidth="1.5"
            android:strokeColor="#00FFCC"
            android:strokeLineCap="round"
            android:pathData="M28,54 L36,46 M80,54 L72,46" />

