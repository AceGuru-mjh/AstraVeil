        <path
            android:fillColor="#151333"
            android:pathData="M32,38 L44,38 L32,56 Z" />

        <path
            android:fillColor="#151333"
            android:pathData="M76,38 L64,38 L76,56 Z" />

        <!-- Symmetrical Visor / Symmetrical Eyes (Tech Glowing Visor) -->
        <!-- Neon Cyan Visor Base -->
        <path
            android:pathData="M34,44 L74,44 L70,52 L38,52 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="34"
                    android:startY="48"
                    android:endX="74"
                    android:endY="48"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#005544" />
                    <item android:offset="0.5" android:color="#00FFCC" />
                    <item android:offset="1.0" android:color="#005544" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Visor Glowing Slits (Left & Right Eye Laser lines) -->
        <path
            android:strokeWidth="1"
            android:strokeColor="#FFFFFF"
            android:pathData="M38,48 L50,48 M58,48 L68,48" />

