{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://astraveil.com/schemas/module-package/v1",
  "title": "AstraVeil Module Package Manifest",
  "description": "模块包内 manifest.json 的 Schema。每个 .astra 包根目录必须包含此文件。",
  "type": "object",
  "required": [
    "manifest_version",
    "module_id",
    "name",
    "version",
    "version_code",
    "entry_point",
    "permissions"
  ],
  "additionalProperties": false,
  "properties": {
    "manifest_version": {
      "type": "integer",
      "const": 1
    },
    "module_id": {
      "type": "string",
      "pattern": "^com\\.[a-z0-9_]+(\\.[a-z0-9_]+){1,5}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "description": {
      "type": "string",
      "maxLength": 1024
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9.]+)?(\\+[a-zA-Z0-9.]+)?$"
    },
    "version_code": {
      "type": "integer",
      "minimum": 1
    },
    "author": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "entry_point": {
      "type": "object",
      "required": ["type", "path"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["native", "dex", "script", "wasm"]
        },
        "path": {
          "type": "string",
          "description": "包内相对路径",
          "examples": ["lib/arm64-v8a/libmodule.so", "classes.dex", "init.sh"]
        },
        "init_function": {
          "type": "string",
          "description": "Native 模块的 C 入口函数名",
          "default": "astra_module_init"
        },
        "min_sdk_version": {
          "type": "integer",
          "minimum": 26
        }
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "模块请求的权限列表",
      "examples": [["network.filter", "file.read.sandbox", "process.monitor"]]
    },
    "resource_quota": {
      "type": "object",
      "properties": {
        "memory_bytes": { "type": "integer", "minimum": 0 },
        "cpu_millicores": { "type": "integer", "minimum": 0 },
        "disk_bytes": { "type": "integer", "minimum": 0 },
        "max_threads": { "type": "integer", "minimum": 1 },
        "max_fds": { "type": "integer", "minimum": 1 }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["module_id", "min_version"],
        "properties": {
          "module_id": { "type": "string" },
          "min_version": { "type": "string" }
        }
      }
    },
    "config_schema": {
      "type": "object",
      "description": "模块配置的 JSON Schema（供 UI 动态渲染设置界面）"
    },
    "hooks": {
      "type": "object",
      "description": "生命周期钩子脚本（包内相对路径）",
      "properties": {
        "pre_install": { "type": "string" },
        "post_install": { "type": "string" },
        "pre_uninstall": { "type": "string" },
        "post_uninstall": { "type": "string" },
        "on_update": { "type": "string" }
      }
    },
    "supported_abis": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["arm64-v8a", "x86_64", "armeabi-v7a", "x86"]
      },
      "description": "支持的 ABI（native 模块必填）"
    },
    "selinux_policy": {
      "type": "string",
      "description": "包内 SELinux 策略文件路径（可选）"
    }
  }
}
