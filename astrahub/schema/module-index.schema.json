{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://astraveil.com/schemas/module-index/v1",
  "title": "AstraHub Module Index",
  "description": "AstraHub 模块索引文件的 JSON Schema。定义所有可分发模块的元数据。",
  "type": "object",
  "required": [
    "schema_version",
    "repository",
    "updated_at",
    "modules"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Schema 版本号。当前固定为 1。"
    },
    "repository": {
      "type": "object",
      "required": [
        "id",
        "name",
        "base_url"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "description": "仓库唯一标识符（小写字母/数字/点/连字符）"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "仓库显示名称"
        },
        "description": {
          "type": "string",
          "maxLength": 512
        },
        "base_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "description": "模块包下载基础 URL（必须 HTTPS）"
        },
        "public_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/=]{40,200}$",
          "description": "仓库 Ed25519 公钥（Base64 编码）"
        },
        "maintainers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "email"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "email": {
                "type": "string",
                "format": "email"
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            }
          }
        }
      }
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "索引最后更新时间（ISO 8601）"
    },
    "categories": {
      "type": "array",
      "description": "可用分类定义",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]{2,32}$"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "parent_id": {
            "type": "string"
          }
        }
      }
    },
    "modules": {
      "type": "array",
      "description": "模块列表",
      "items": {
        "$ref": "#/definitions/module_entry"
      }
    }
  },
  "definitions": {
    "module_entry": {
      "type": "object",
      "required": [
        "module_id",
        "name",
        "version",
        "author",
        "category",
        "min_sdk_version",
        "min_daemon_version",
        "package",
        "checksum",
        "signature",
        "published_at"
      ],
      "additionalProperties": false,
      "properties": {
        "module_id": {
          "type": "string",
          "pattern": "^com\\.[a-z0-9_]+(\\.[a-z0-9_]+){1,5}$",
          "description": "模块唯一标识（反向域名格式）",
          "examples": [
            "com.astraveil.module.firewall"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "模块显示名称"
        },
        "description": {
          "type": "string",
          "maxLength": 1024
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9.]+)?(\\+[a-zA-Z0-9.]+)?$",
          "description": "语义化版本号 (SemVer 2.0)"
        },
        "version_code": {
          "type": "integer",
          "minimum": 1,
          "description": "单调递增版本码（用于升级判断）"
        },
        "author": {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "email": {
              "type": "string",
              "format": "email"
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "verified": {
              "type": "boolean",
              "default": false,
              "description": "是否为已验证开发者"
            }
          }
        },
        "category": {
          "type": "string",
          "description": "分类 ID（必须在 categories 中定义）"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_-]{1,32}$"
          },
          "maxItems": 16,
          "uniqueItems": true
        },
        "icon_url": {
          "type": "string",
          "format": "uri",
          "description": "模块图标 URL（相对于 base_url）"
        },
        "screenshots": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "maxItems": 8
        },
        "license": {
          "type": "string",
          "description": "SPDX 许可证标识符",
          "examples": [
            "MIT",
            "Apache-2.0",
            "GPL-3.0-only"
          ]
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "description": "源代码仓库 URL"
        },
        "min_sdk_version": {
          "type": "integer",
          "minimum": 26,
          "maximum": 36,
          "description": "最低 Android API Level"
        },
        "max_sdk_version": {
          "type": "integer",
          "minimum": 26,
          "maximum": 36,
          "description": "最高测试 Android API Level"
        },
        "min_daemon_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "最低 astrad 版本 (SemVer)"
        },
        "min_app_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "最低 AstraVeil App 版本"
        },
        "required_capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "所需系统能力列表"
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "模块请求的权限列表"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "module_id",
              "min_version"
            ],
            "properties": {
              "module_id": {
                "type": "string"
              },
              "min_version": {
                "type": "string"
              }
            }
          },
          "description": "依赖的其他模块"
        },
        "package": {
          "type": "object",
          "required": [
            "url",
            "format",
            "size_bytes"
          ],
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string",
              "description": "包下载路径（相对于 base_url）"
            },
            "format": {
              "type": "string",
              "enum": [
                "astra",
                "apk",
                "so",
                "zip"
              ],
              "description": "包格式"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 104857600,
              "description": "文件大小（最大 100MB）"
            },
            "entry_point": {
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "native",
                    "dex",
                    "script",
                    "wasm"
                  ]
                },
                "path": {
                  "type": "string"
                },
                "init_function": {
                  "type": "string"
                }
              }
            }
          }
        },
        "checksum": {
          "type": "object",
          "required": [
            "algorithm",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": [
                "sha256",
                "sha512",
                "blake3"
              ]
            },
            "value": {
              "type": "string",
              "pattern": "^[a-f0-9]{64,128}$",
              "description": "十六进制校验和"
            }
          }
        },
        "signature": {
          "type": "object",
          "required": [
            "algorithm",
            "value",
            "signer"
          ],
          "additionalProperties": false,
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": [
                "ed25519",
                "rsa-pss-sha256"
              ]
            },
            "value": {
              "type": "string",
              "description": "Base64 编码签名"
            },
            "signer": {
              "type": "string",
              "description": "签名者标识"
            },
            "public_key_fingerprint": {
              "type": "string",
              "description": "签名公钥 SHA-256 指纹"
            },
            "certificate_chain": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "PEM 证书链（可选）"
            }
          }
        },
        "published_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "deprecated": {
          "type": "boolean",
          "default": false,
          "description": "是否已弃用"
        },
        "deprecation_notice": {
          "type": "string",
          "description": "弃用说明（deprecated=true 时必填）"
        },
        "downloads": {
          "type": "integer",
          "minimum": 0,
          "description": "下载次数（由服务端维护）"
        },
        "rating": {
          "type": "object",
          "properties": {
            "average": {
              "type": "number",
              "minimum": 0,
              "maximum": 5
            },
            "count": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "versions": {
          "type": "array",
          "description": "历史版本列表（用于降级/回滚）",
          "items": {
            "type": "object",
            "required": [
              "version",
              "version_code",
              "package",
              "checksum",
              "published_at"
            ],
            "properties": {
              "version": {
                "type": "string"
              },
              "version_code": {
                "type": "integer"
              },
              "package": {
                "$ref": "#/definitions/module_entry/properties/package"
              },
              "checksum": {
                "$ref": "#/definitions/module_entry/properties/checksum"
              },
              "signature": {
                "$ref": "#/definitions/module_entry/properties/signature"
              },
              "published_at": {
                "type": "string",
                "format": "date-time"
              },
              "changelog": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
