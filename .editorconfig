# EditorConfig — https://editorconfig.org
# Cross-editor / IDE format consistency for the AstraVeil monorepo.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Kotlin / Gradle Kotlin DSL
[*.{kt,kts}]
indent_size = 4
max_line_length = 120
# ktlint integration (when enabled): allow wildcard imports for now
ktlint_standard_no-wildcard-imports = disabled

# Java / XML (Android resources)
[*.{java,xml}]
indent_size = 4

# JSON / YAML / TOML
[*.{json,yaml,yml,toml}]
indent_size = 2

# Protobuf
[*.proto]
indent_size = 2

# Markdown — lists use 2-space indentation
[*.md]
indent_size = 2

# License file (Apache 2.0 uses 2-space indent for copyright line)
[LICENSE]
indent_size = 2

# Plain text
[*.txt]
indent_size = 2

# C++ / headers (daemon + native + module-spoof)
[*.{cpp,cc,cxx,h,hpp,hxx}]
indent_size = 4
max_line_length = 100

# Rust
[*.{rs,toml}]
# Rust convention is 4-space; Cargo.toml commonly 4
indent_size = 4

# Shell scripts
[*.sh]
indent_size = 4

# Makefiles require tabs
[Makefile]
indent_style = tab

# Markdown — preserve trailing whitespace (two-spaces = line break)
[*.md]
trim_trailing_whitespace = false
max_line_length = off
